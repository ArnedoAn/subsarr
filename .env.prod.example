
# Optional: opt in ONLY after checking media write permissions and LXC UID mapping.
# With neither set, upgrades retain legacy root ownership/execution with a warning.
# PUID=1000
# PGID=1000

OPENROUTER_API_KEY=sk-or-...
DEEPSEEK_API_KEY=sk-...
SUBSYNC_MEDIA_VOLUME=/path/to/jellyfin/media
SUBSYNC_DATA_VOLUME=./data
# En el contenedor, /data debe coincidir con SUBSYNC_DATA_DIR (SQLite, perfiles, glosario, history)
# SUBSYNC_DATABASE_PATH=/data/subsarr.db
SUBSYNC_MEDIA_DIRS=/media/movies,/media/series
SUBSYNC_SCAN_CACHE_TTL_MINUTES=30
SUBSYNC_SOURCE_LANGUAGE=eng
SUBSYNC_TARGET_LANGUAGE=spa
SUBSYNC_CONCURRENCY=2
SUBSYNC_PATH_EXCLUSIONS=/ignore/,/raw/
SUBSYNC_FILE_TOO_LARGE_BYTES=
NEXT_PUBLIC_API_URL=/api
# Optional stable 64-hex-character encryption key; otherwise generated in /data.
# SUBSARR_SECRET_KEY=
# Only app data is recursively chowned; /app and media are never changed.
# Standalone images without PUID/PGID preserve legacy root with a warning;
# Compose leaves mapping unset by default. Do not force Compose user for migration.
# A forced nonroot runtime requires preexisting writable data/DB/settings and media.
