OPENROUTER_API_KEY=sk-or-...
DEEPSEEK_API_KEY=sk-...
REDIS_URL=redis://redis:6379
SUBSYNC_MEDIA_DIRS=/media/movies,/media/series
SUBSYNC_SCAN_CACHE_TTL_MINUTES=30
SUBSYNC_SOURCE_LANGUAGE=eng
SUBSYNC_TARGET_LANGUAGE=spa
SUBSYNC_CONCURRENCY=2
SUBSYNC_SETTINGS_FILE_PATH=/data/subsync.settings.json
# Carpeta de datos (Docker: suele ser /data y debe coincidir con el volumen montado)
SUBSYNC_DATA_DIR=/data
# Opcional: SQLite (por defecto: SUBSYNC_DATA_DIR/subsarr.db)
# SUBSYNC_DATABASE_PATH=/data/subsarr.db
SUBSYNC_PATH_EXCLUSIONS=/ignore/,/raw/
SUBSYNC_FILE_TOO_LARGE_BYTES=
NEXT_PUBLIC_API_URL=/api
# Optional: opt in ONLY after checking media write permissions and LXC UID mapping.
# With neither set, upgrades retain legacy root ownership/execution with a warning.
# PUID=1000
# PGID=1000
SUBSYNC_MEDIA_VOLUME=./media
SUBSYNC_DATA_VOLUME=./data
# Optional 64-hex-character encryption key; otherwise generated in /data.
# SUBSARR_SECRET_KEY=
# Only app data is recursively chowned; application and media trees are never changed.
# Without BOTH PUID/PGID the standalone image preserves legacy root execution
# with a security warning. Compose does not select a mapping automatically.
# A forced nonroot runtime must already have writable data/DB/settings and media.
